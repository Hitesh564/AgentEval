# AgentEval Environment Configuration

# LLM Providers (for LLM-judge metrics and root cause evaluation)
# LiteLLM will use these keys based on the model selected.
GEMINI_API_KEY=""
OPENAI_API_KEY=

# Application Server Config
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to local SQLite if unset)
DATABASE_PATH=agenteval.db
AGENTEVAL_DATABASE_URL="sqlite:///agenteval.db"
# For PostgreSQL:
# AGENTEVAL_DATABASE_URL="postgresql://agenteval:agenteval@localhost:5432/agenteval"

# Cost and Token Safety Guards
AGENTEVAL_MAX_COST_USD_PER_RUN=1.00
AGENTEVAL_MAX_TOKENS_PER_CALL=4096
