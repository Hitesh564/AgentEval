# AgentEval Environment Configuration

# LLM Providers
# LiteLLM will use these keys based on the model selected.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Application Server Config
PORT=8000
HOST=127.0.0.1
AGENTEVAL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Local development uses SQLite when AGENTEVAL_DATABASE_URL is unset.
# Production should always set AGENTEVAL_DATABASE_URL to a PostgreSQL URL.
#
# LOCAL DEVELOPMENT
# AGENTEVAL_DATABASE_URL=sqlite:///./agenteval.db
#
# PRODUCTION - SUPABASE POSTGRESQL
# AGENTEVAL_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Hosted API bootstrap and deployment
# AGENTEVAL_API_URL=https://your-agent-eval-api.example.com
# AGENTEVAL_ADMIN_BOOTSTRAP_KEY=generate-a-long-random-secret
# VITE_API_BASE_URL=https://your-agent-eval-api.example.com

# Optional connection pool tuning for PostgreSQL
# AGENTEVAL_DB_POOL_SIZE=5
# AGENTEVAL_DB_MAX_OVERFLOW=10

# Cost and Token Safety Guards
AGENTEVAL_MAX_COST_USD_PER_RUN=1.00
AGENTEVAL_MAX_TOKENS_PER_CALL=4096
